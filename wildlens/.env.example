# WildLens optional AI configuration.
# Copy this file to `.env` and fill in the values to route the language-model
# AI moments (curiosity classification, Wrapped reflection, and "Ask the Animal")
# to a real LLM. If left unset, WildLens runs its deterministic LOCAL fallbacks
# so the whole demo works offline with zero setup and zero cost.

# HTTP endpoint that accepts { "prompt": "..." } and returns
# { "text": "..." } (or { "output" } / { "completion" }).
# e.g. a thin proxy in front of Amazon Bedrock / OpenAI / your own model.
VITE_AI_ENDPOINT=

# Optional bearer token sent as `Authorization: Bearer <key>` to that endpoint.
VITE_AI_API_KEY=

# NOTE: the on-device vision AI (Look-to-Unlock camera + scan-any-animal) needs
# NO key and NO endpoint — it runs entirely in the browser via TensorFlow.js.
